{
    "name": "omnilang/google",
    "type": "library",
    "description": "Omnilang's Google Cloud Translation - Advanced (v3), under any PHP host: texts and HTML translated, languages detected, the supported languages, glossaries listed, read, applied and deleted, PDF and Office documents translated at once - the OAuth access token given by reference, Google's usage policy (quotas, the required attribution) declared as data.",
    "keywords": [
        "google",
        "google-translate",
        "google-cloud",
        "translation",
        "machine-translation",
        "glossary",
        "document-translation",
        "framework-agnostic",
        "omnilang"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnilang-google",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnilang": "^1.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnilang\\Google\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnilang\\Google\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
